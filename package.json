{
  "name": "battleships",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @bs/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc --noEmit -p apps/api && tsc --noEmit -p apps/web && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "audio": "tsx tools/audio/render.ts",
    "bench": "tsx tools/bench.ts",
    "docs": "tsx tools/docgen/src/index.ts",
    "docs:check": "tsx tools/docgen/src/index.ts --check",
    "e2e": "playwright test",
    "e2e:server": "pnpm --filter @bs/web build && pnpm --filter @bs/api exec wrangler d1 migrations apply battleships --local && pnpm --filter @bs/api exec wrangler dev --ip 127.0.0.1 --port 8788",
    "dev:api": "pnpm --filter @bs/api dev",
    "dev:web": "pnpm --filter @bs/web dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@bs/protocol": "workspace:^",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11"
  }
}
