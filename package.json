{
  "name": "battleships",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @bs/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc --noEmit -p apps/api && tsc --noEmit -p apps/web",
    "lint": "eslint .",
    "audio": "tsx tools/audio/render.ts",
    "bench": "tsx tools/bench.ts",
    "docs": "tsx tools/docgen/src/index.ts",
    "docs:check": "tsx tools/docgen/src/index.ts --check",
    "dev:api": "pnpm --filter @bs/api dev",
    "dev:web": "pnpm --filter @bs/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.8"
  }
}
